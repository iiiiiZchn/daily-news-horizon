{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh", "en"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": false
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": false
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 50
    },
    "rss": [
      {
        "name": "BBC World",
        "url": "https://feeds.bbci.co.uk/news/world/rss.xml",
        "enabled": true,
        "category": "world"
      },
      {
        "name": "NPR News",
        "url": "https://feeds.npr.org/1001/rss.xml",
        "enabled": true,
        "category": "world"
      },
      {
        "name": "The Guardian",
        "url": "https://www.theguardian.com/world/rss",
        "enabled": true,
        "category": "world"
      },
      {
        "name": "Al Jazeera",
        "url": "https://www.aljazeera.com/xml/rss/all.xml",
        "enabled": true,
        "category": "world"
      },
      {
        "name": "ABC News",
        "url": "https://abcnews.go.com/abcnews/internationalheadlines",
        "enabled": true,
        "category": "world"
      },
      {
        "name": "SCMP",
        "url": "https://www.scmp.com/rss/91/feed",
        "enabled": true,
        "category": "world"
      },
      {
        "name": "TechCrunch",
        "url": "https://techcrunch.com/feed/",
        "enabled": true,
        "category": "tech"
      },
      {
        "name": "Ars Technica",
        "url": "https://feeds.arstechnica.com/arstechnica/index",
        "enabled": true,
        "category": "tech"
      },
      {
        "name": "The Verge",
        "url": "https://www.theverge.com/rss/index.xml",
        "enabled": true,
        "category": "tech"
      },
      {
        "name": "CNBC Top News",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=100003114",
        "enabled": true,
        "category": "business"
      },
      {
        "name": "Nature",
        "url": "https://www.nature.com/nature.rss",
        "enabled": true,
        "category": "science"
      },
      {
        "name": "BBC 中文",
        "url": "https://feeds.bbci.co.uk/zhongwen/simp/rss.xml",
        "enabled": true,
        "category": "china"
      },
      {
        "name": "DW 中文",
        "url": "https://rss.dw.com/rdf/rss-chi-all",
        "enabled": true,
        "category": "china"
      },
      {
        "name": "纽约时报中文",
        "url": "https://cn.nytimes.com/rss/",
        "enabled": true,
        "category": "china"
      },
      {
        "name": "Simon Willison's Blog",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "tech"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "users": []
    },
    "openbb": {
      "enabled": false,
      "watchlists": []
    },
    "ossinsight": {
      "enabled": false
    },
    "gdelt": {
      "enabled": false
    },
    "google_news": {
      "enabled": false
    }
  },
  "filtering": {
    "ai_score_threshold": 5.0,
    "time_window_hours": 24,
    "max_items": 25,
    "category_groups": {
      "world": {
        "limit": 8,
        "categories": ["world"]
      },
      "china": {
        "limit": 5,
        "categories": ["china"]
      },
      "tech": {
        "limit": 6,
        "categories": ["tech"]
      },
      "business": {
        "limit": 4,
        "categories": ["business"]
      },
      "science": {
        "limit": 3,
        "categories": ["science"]
      }
    },
    "default_group": "other",
    "default_group_limit": 3
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "first",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": ["zh", "en"],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "📰 每日新闻速递 | #{date}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
